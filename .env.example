# ============================================================
# SPLARO — Environment Variables
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local to version control
# ============================================================

# ── APP ─────────────────────────────────────────────────────
# Local dev: use http://localhost:3000 / :3001 / :4000 (see pnpm dev:stack)
# Production = Contabo VPS (147.93.171.45) → splaro.co / admin.splaro.co
# Hostinger is NOT primary — ignore Deploy Hostinger in Actions (legacy smoke only).
NODE_ENV=development
# Production VPS overrides this to production in /var/www/splaro/.env
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend alias when NEXT_PUBLIC_SITE_URL unset (invoices, SEO, emails)
SITE_URL=http://localhost:3000
# Set to true to show maintenance page site-wide (preview at /maintenance anytime)
NEXT_PUBLIC_MAINTENANCE_MODE=false
# ISO date when maintenance ends — used for countdown (Bangladesh time +06:00)
NEXT_PUBLIC_MAINTENANCE_UNTIL=2026-07-01T00:00:00+06:00
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_CDN_URL=
# Facebook domain verification — ONLY set the real code from Meta Business Manager.
# NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
INTERNAL_API_URL=http://127.0.0.1:4000/api/v1
# Contabo same-box: SSR loopback + sharp off. SPLARO_HOSTINGER is legacy alias only.
SPLARO_VPS=1
# SPLARO_HOSTINGER=1
PORT_WEB=3000
PORT_ADMIN=3001
PORT_API=4000
API_PORT=4000

# ── ADMIN PANEL AUTH ─────────────────────────────────────────
# Must match CEO_EMAIL in apps/admin/src/lib/auth/role-label.ts
ADMIN_EMAIL=splaro.bd@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=splaro.bd@gmail.com
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=splaro_bot
# DEV ONLY — never use this password in production (validate-production-env blocks it)
ADMIN_PASSWORD=change-me-local-only
ADMIN_SESSION_SECRET=your-admin-session-secret-min-32-chars
JWT_SECRET=your-super-secret-256-bit-key-change-in-production
REVALIDATE_SECRET=your-revalidate-secret-min-16-chars
INTERNAL_HEALTH_SECRET=your-internal-health-probe-secret
# Private MCP HTTP (PM2 splaro-mcp). Admin proxies https://admin.splaro.co/mcp/* → :4005
# MCP_TRANSPORT=sse
# MCP_PORT=4005
# MCP_SSE_MESSAGE_PATH=/mcp/message
# MCP_API_KEY=optional-bootstrap-bearer-also-accepted-by-nest
# SPLARO_MCP_SERVICE_TOKEN=optional-stdio-write-bearer
# MCP_UPSTREAM_URL=http://127.0.0.1:4005
# Set to 1 only for one-time seed/demo cleanup on deploy (default off — protects real catalog)
SPLARO_PURGE_DEMO_ON_DEPLOY=0
ENCRYPTION_KEY=your-encryption-key-minimum-32-characters-long
# Optional rolling-rotation fallback. Remove after encrypted integrations are re-saved.
ENCRYPTION_KEY_PREVIOUS=
NEXT_PUBLIC_STORE_ID=splaro

# ── DATABASE ─────────────────────────────────────────────────
# One live store DB. Keep TWO URLs to the SAME Postgres project:
#   1) DATABASE_URL        = runtime (local Docker OR Supabase pooler :6543 + pgbouncer=true)
#   2) DATABASE_URL_SHADOW = migrations only (local shadow DB OR Supabase direct :5432)
# Do NOT point the app at Hostinger MySQL, or run two different “production” Prisma DBs.
# Local VPS / Docker:
# DATABASE_URL=postgresql://splaro_user:PASS@127.0.0.1:5432/splaro_db
# Supabase (pooler — app runtime):
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase (direct — migrations / shadow):
# DATABASE_URL_SHADOW=postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://splaro_user:STRONG_PASSWORD@localhost:5432/splaro_db
DATABASE_URL_SHADOW=postgresql://splaro_user:STRONG_PASSWORD@localhost:5432/splaro_shadow_db
# API boot: retries before exit (production exits if DB still down)
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_MS=1500
# Admin DB credential test timeout (ms)
DATABASE_TEST_TIMEOUT_MS=20000

# ── SUPABASE ─────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Legacy aliases (same values — Prisma / older scripts)
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# ── ANALYTICS (storefront) ───────────────────────────────────
# Direct gtag.js + Meta Pixel (no GTM container). Admin → Settings → Marketing
# also stores GA4 / Pixel IDs; bootstrap copies these into SiteSettings when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Alias read by AnalyticsScripts when measurement ID unset in admin settings
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Meta Pixel / GA4 / Microsoft Clarity
NEXT_PUBLIC_FB_PIXEL_ID=
FB_PIXEL_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Nest Meta CAPI (server-only — never expose to the browser)
FB_CAPI_ACCESS_TOKEN=
# Local DebugView / Pixel test: load tags on localhost (otherwise production-only)
# NEXT_PUBLIC_ANALYTICS_DEBUG=1
# Google Ads (optional) — AW id + Purchase conversion label from Google Ads → Tools → Conversions
# Do not also import GA4 Purchase into Ads if this tag is enabled (double conversion).
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=xxxxxxxxxxxxxxxx
# Meta domain verification meta tag content (Business Manager → Brand Safety → Domains)
# NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=

# Local / VPS Redis — use 127.0.0.1 (not localhost) to avoid Windows IPv6 stalls.
# Production VPS: REDIS_ENABLED must stay true (OTP limits + courier retry queue).
# Local without Redis: brew/docker + pnpm infra:redis — do NOT set REDIS_ENABLED=false on VPS.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DB=0
REDIS_ENABLED=true

# ── MEILISEARCH (VPS local — fast storefront search) ───────
# Run: bash infrastructure/vps/setup-meilisearch.sh (binds 127.0.0.1:7700 only)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=your-meilisearch-master-key-min-32-chars

# ── RATE LIMITING & THROTTLE ─────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=200

# Production DATABASE_URL tip: add ?connection_limit=20&pool_timeout=20

# ── JWT AUTH ─────────────────────────────────────────────────
JWT_SECRET=your-super-secret-256-bit-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-different-from-above
JWT_REFRESH_EXPIRES_IN=30d

# ── NEXT AUTH (if using Auth.js) ──────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=https://splaro.co

# ── BKASH PAYMENT ────────────────────────────────────────────
# Leave empty until you have real Merchant API keys (Admin → Settings → Infrastructure preferred).
# Local sandbox without merchant keys: PAYMENT_DEV_STUB=true
# Production / Hostinger: MUST be false (API boot rejects stub in production)
PAYMENT_DEV_STUB=false
# Browser launch gate for bKash/Nagad/SSL. Admin payment toggles alone are not enough —
# set this true only after real keys + *_SANDBOX=false + verified callback smoke tests.
NEXT_PUBLIC_DIGITAL_PAYMENTS_ENABLED=false
# Pending digital checkouts reserve stock for this many minutes (5-120).
PAYMENT_STOCK_RESERVATION_MINUTES=15
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
# For sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta

# ── NAGAD PAYMENT ────────────────────────────────────────────
NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_MERCHANT_PRIVATE_KEY=your-nagad-private-key
NAGAD_MERCHANT_PUBLIC_KEY=nagad-provided-public-key
NAGAD_BASE_URL=https://api.mynagad.com
# For sandbox: http://sandbox.mynagad.com:10080

# ── SSLCOMMERZ PAYMENT ───────────────────────────────────────
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_BASE_URL=https://securepay.sslcommerz.com
# For sandbox: https://sandbox.sslcommerz.com

# ── STEADFAST COURIER ────────────────────────────────────────
# Leave empty until you have real Merchant API keys (Admin → Settings → Infrastructure preferred).
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
# Optional — also settable in Admin → Settings → Infrastructure (Webhook Auth Token).
# Steadfast portal sends Authorization: Bearer <token> to POST /api/v1/webhooks/steadfast
# (legacy alias: POST /api/v1/courier/steadfast-webhook). GET either URL returns readiness JSON.
STEADFAST_WEBHOOK_BEARER_TOKEN=
# Auto-book Steadfast on new order (via API). Set false to disable.
AUTO_COURIER_BOOK=true
DEFAULT_COURIER_PROVIDER=STEADFAST
# Simulate Steadfast booking locally when API keys are placeholders.
# Production VPS: MUST stay false. Missing keys = honest book fail (nothing saved as BOOKED).
COURIER_DEV_STUB=false

# Opt-in: auto-seed Unsplash demo products on API boot when catalog is empty (production only).
# Default off — empty shop stays empty until real products are added. Explicit deploy hook
# POST /api/v1/storefront/deploy/seed-demo still works with INTERNAL_HEALTH_SECRET.
ALLOW_DEMO_CATALOG_SEED=false

# ── PATHAO COURIER ───────────────────────────────────────────
PATHAO_CLIENT_ID=your-pathao-client-id
PATHAO_CLIENT_SECRET=your-pathao-client-secret
PATHAO_USERNAME=your-pathao-username
PATHAO_PASSWORD=your-pathao-password
PATHAO_BASE_URL=https://merchant.pathao.com/api/v1
# For sandbox: https://hermes.p-stageenv.xyz/aladdin/api/v1

# ── REDX COURIER ─────────────────────────────────────────────
REDX_API_KEY=your-redx-api-key
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta

# ── PAPERFLY COURIER ─────────────────────────────────────────
PAPERFLY_API_USER=your-paperfly-api-user
PAPERFLY_API_PASSWORD=your-paperfly-api-password
PAPERFLY_BASE_URL=https://mrx.paperfly.com.bd/api

# ── CLOUDFLARE R2 STORAGE ────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=splaro-assets
CLOUDFLARE_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://splaro.co
# Storefront image resolver — never point at DNS-missing cdn.splaro.co / cdn.splaro.com.bd
# (apps/web resolve-asset-url.ts skips those hosts). Custom CDN only after DNS+R2 public bind.
NEXT_PUBLIC_R2_PUBLIC_URL=https://splaro.co
# Homepage default heroes: self-hosted WebP at apps/web/public/images/hero/* (ILYN-style static CDN).
# Re-sync: scripts on VPS or `cwebp` from Unsplash masters — see AGENTS.md / splaro-platform skill.
# Admin catalog uploads: prefer WebP / pre-sized JPEG — VPS keeps images.unoptimized (SPLARO_VPS=1);
# Next will not resize on the fly, so file URL must already be the right weight.

# ── OPENAI (AI FEATURES) ─────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_MINI=gpt-4o-mini

# ── ANTHROPIC CLAUDE (SPLARO AI AGENT) ───────────────────────
# Option A: Direct API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-opus-5
# Option B: Antigravity proxy (Google login via local proxy, like Claude Code)
# Run: npx antigravity-claude-proxy  →  add Google account at http://localhost:8080
ANTHROPIC_BASE_URL=http://localhost:8080
ANTHROPIC_AUTH_TOKEN=test

# ── GOOGLE GEMINI (SPLARO AI AGENT) ──────────────────────────
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro

# ── XAI GROK (SPLARO AI AGENT) ───────────────────────────────
# Get key: https://console.x.ai
GROK_API_KEY=your-grok-api-key
GROK_MODEL=grok-4

# ── MANUS (autonomous task delegation) ───────────────────────
# NOT an agent-brain model — Manus runs its own agent with its own tools, so it
# cannot answer questions about SPLARO orders/stock/finance. It is used from
# /dashboard/manus to delegate long-running jobs (research, scraping, docs).
# Prefer: Admin → AI Command Brain → API keys → Manus (encrypted in DB).
# Optional env fallback if no DB key is saved:
# Get key: Manus web app → Settings → API keys
MANUS_API_KEY=your-manus-api-key

# ── SPLARO AI AGENT (Command Brain v2) ───────────────────────
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_MAX_TOKENS_PER_RUN=5000
AGENT_DAILY_COST_LIMIT_USD=2.00
AGENT_READ_CACHE_TTL_SEC=120

# ── EMAIL (SMTP) ─────────────────────────────────────────────
# Hostinger mail for splaro.co — create mailbox in hPanel first
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@splaro.co
SMTP_PASS=your-email-password
EMAIL_FROM_NAME=SPLARO
EMAIL_FROM_ADDRESS=noreply@splaro.co
SMTP_FROM_NAME=SPLARO
SMTP_FROM_EMAIL=noreply@splaro.co
SMTP_REPLY_TO=support@splaro.co

# ── SMS (Bangladesh) ─────────────────────────────────────────
# Prefer saving keys in Admin → SMS Center (encrypted). Env is fallback only.
# Gateways: bdbulksms | elitbuzz | greenweb | custom
# SMS_PROVIDER=bdbulksms
# SMS_API_URL=https://bulksmsbd.net/api/smsapi
# BDBULKSMS_API_KEY=
# BDBULKSMS_SENDER_ID=SPLARO
# ELITBUZZ_API_TOKEN=
# ELITBUZZ_SENDER_ID=SPLARO
# GREENWEB_SMS_USER=
# GREENWEB_SMS_PASS=
# SMS_API_KEY=
# SMS_SENDER_ID=SPLARO

# ── WHATSAPP BUSINESS ────────────────────────────────────────
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
# WhatsApp contact number for customer chat:
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801905010205

# ── TELEGRAM BOT (order alerts + admin commands) ─────────────
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Optional — production VPS: webhook (recommended). Local dev: leave unset + polling.
# TELEGRAM_WEBHOOK_URL=https://api.splaro.co/api/v1/telegram-webhook
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
# 1 = polling (local dev only). Production VPS: set 0 when using TELEGRAM_WEBHOOK_URL.
# SPLARO_TELEGRAM_POLLING=1
# Numeric Telegram user ID for bot permissions (your personal ID, not group)
TELEGRAM_ADMIN_USER_ID=your-telegram-user-id
# Bot username for admin login page (without @)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=splaro_bot
TELEGRAM_STORE_SLUG=splaro
# Customer support link on storefront (username, not bot token):
NEXT_PUBLIC_TELEGRAM_USERNAME=splaro_support

# ── GOOGLE SHEETS SYNC ───────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_ENABLED=true
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./tools/google-sheets-sync/credentials/service-account.json
GOOGLE_DEFAULT_SPREADSHEET_ID=your-default-spreadsheet-id
# Gmail OAuth (admin → Google Workspace → Connect Gmail)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/admin/google/callback
GOOGLE_OAUTH_LOGIN_HINT=splaro.bd@gmail.com
# Optional Search Console property override (Domain or URL-prefix).
# Enable Search Console API on the same GCP project as GOOGLE_CLIENT_ID.
# Example: sc-domain:splaro.co   or   https://splaro.co/
GOOGLE_SEARCH_CONSOLE_PROPERTY=

# ── STOREFRONT GOOGLE SIGN-IN (customers — separate from admin Workspace OAuth) ──
# Create an OAuth 2.0 Web client in Google Cloud Console (not the admin redirect).
# Authorized JavaScript origins (must include BOTH local hosts — GSI rejects the other):
#   http://localhost:3000
#   http://127.0.0.1:3000
#   https://splaro.co
# Authorized redirect URIs (if using redirect flow): https://splaro.co/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-storefront-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-storefront-client-secret
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-storefront-client-id.apps.googleusercontent.com
# Keep false until both http://localhost:3000 and http://127.0.0.1:3000 are registered
# as Authorized JavaScript origins for this OAuth client in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_OAUTH_LOCAL_ENABLED=false

GOOGLE_SHEETS_ORDERS_ID=your-google-sheet-id-for-orders
GOOGLE_SHEETS_INVENTORY_ID=your-google-sheet-id-for-inventory
GOOGLE_SHEETS_CUSTOMERS_ID=your-google-sheet-id-for-customers
GOOGLE_SHEETS_PRODUCTS_ID=your-google-sheet-id-for-products
GOOGLE_SHEETS_PARTNERS_ID=your-google-sheet-id-for-partner-accounts
GOOGLE_SHEETS_EXPENSES_ID=your-google-sheet-id-for-expenses
GOOGLE_SHEETS_PROFIT_LOSS_ID=your-google-sheet-id-for-profit-loss
GOOGLE_SHEETS_COURIER_ID=your-google-sheet-id-for-courier
GOOGLE_SHEETS_PAYMENT_ID=your-google-sheet-id-for-payment
GOOGLE_SHEETS_DAILY_SUMMARY_ID=your-google-sheet-id-for-daily-summary
GOOGLE_SHEETS_TELEGRAM_LOGS_ID=your-google-sheet-id-for-telegram-logs
GOOGLE_SHEETS_AI_JOBS_ID=your-google-sheet-id-for-ai-jobs
GOOGLE_SHEETS_REVENUE_ID=your-google-sheet-id-for-revenue
GOOGLE_SHEETS_SYNC_INTERVAL=*/5 * * * *

# ── PRINT SERVICE ────────────────────────────────────────────
PRINT_SERVICE_ENABLED=true
PRINT_SERVICE_URL=http://localhost:5000
THERMAL_PRINTER_HOST=192.168.1.100
THERMAL_PRINTER_PORT=9100
THERMAL_PRINTER_TYPE=EPSON
# Options: EPSON | STAR | CITIZEN | CUSTOM
PRINT_AUTO_INVOICE=true
PRINT_AUTO_LABEL=true
NETWORK_PRINTER_URL=ipp://192.168.1.101/printers/splaro-invoice

# ── INVOICE ──────────────────────────────────────────────────
INVOICE_PREFIX=SPL
INVOICE_STARTING_NUMBER=1000
# HMAC for public invoice links (required in production — no REVALIDATE/INTERNAL fallback)
INVOICE_ACCESS_SECRET=your-invoice-link-signing-secret-min-32-chars
# Optional rotation window after changing INVOICE_ACCESS_SECRET
# INVOICE_ACCESS_SECRET_PREVIOUS=
COMPANY_NAME=SPLARO
COMPANY_ADDRESS=House # 84, Road # 12, Sector 13, Uttara, Dhaka-1230, Bangladesh
COMPANY_PHONE=+880 1700-000000
# E.164 for invoice PDF header (falls back to COMPANY_PHONE)
COMPANY_PHONE_E164=8801905010205
COMPANY_EMAIL=info@splaro.co
COMPANY_WEBSITE=https://splaro.co

# ── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── SECURITY ─────────────────────────────────────────────────
# No trailing slash — use https://splaro.co not https://splaro.co/
CORS_ORIGINS=https://splaro.co,https://admin.splaro.co
CORS_ORIGIN=https://splaro.co,https://admin.splaro.co
ENCRYPTION_KEY=32-character-encryption-key-here
WEBHOOK_SECRET=your-webhook-signing-secret

# ── FEATURE FLAGS (enforced in API + admin nav/UI) ───────────
# Source: packages/config/src/feature-flags.ts → GET /api/v1/features
# false = hide admin nav + block API (@RequireFeature) + hide half-built panels
FEATURE_AI_ENABLED=true
FEATURE_SAAS_ENABLED=false
FEATURE_VENDOR_ENABLED=false
FEATURE_LOYALTY_ENABLED=false
FEATURE_CHATBOT_ENABLED=true
FEATURE_GOOGLE_SHEETS=true
FEATURE_PRINT_AUTO=true
# Optional: Chrome path for invoice PDF (Puppeteer). Mac default usually works:
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Phone OTP on track-order — false = phone only, no SMS cost
STOREFRONT_PHONE_OTP_ENABLED=false
NEXT_PUBLIC_STOREFRONT_PHONE_OTP_ENABLED=false

# ── STOREFRONT CONTACT (public — shown on splaro.co footer/header) ──
STORE_CONTACT_EMAIL=info@splaro.co
NEXT_PUBLIC_SUPPORT_EMAIL=info@splaro.co
NEXT_PUBLIC_SUPPORT_PHONE=+8801905010205
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801905010205

# ── ADMIN LOGIN (private — dashboard only, never shown on storefront) ──

# ── STOREFRONT PERF (optional — code has safe defaults) ───────
# Hero autoplay (default ON). Set 0/false to disable auto-advance.
# NEXT_PUBLIC_HERO_AUTOPLAY=0
# Hero video override on slide 1 (defaults from @splaro/config)
# NEXT_PUBLIC_HERO_VIDEO=https://cdn.splaro.co/videos/hero.mp4
# NEXT_PUBLIC_HERO_VIDEO_MOBILE=https://cdn.splaro.co/videos/hero-mobile.mp4
SPLARO_CATALOG_FETCH_TIMEOUT_MS=8000
SPLARO_CATALOG_FETCH_ATTEMPTS=2
SPLARO_SETTINGS_FETCH_TIMEOUT_MS=8000
SPLARO_UPSTREAM_FETCH_TIMEOUT_MS=8000
SPLARO_CART_SYNC_TIMEOUT_MS=8000

# ── ADMIN UPLOADS (optional local disk when R2 not configured) ─
# Local upload root (admin writes; web serves /uploads/*). Product pipeline stores
# products/{id}.original.* + products/{id}.w{160|480|828|1200|1600}.{webp,avif}
# UPLOAD_DIR=/var/www/splaro-shared/uploads
# PRODUCT_IMAGE_PIPELINE=true
# Max concurrent Sharp product pipelines (server-side semaphore). Default 2.
# PRODUCT_IMAGE_PIPELINE_CONCURRENCY=2
# Opt-in AI upscale for small product photos (<1200px): admin preview → approve.
# Uses Replicate Real-ESRGAN (cloud GPU — not Contabo CPU). Off without token.
# PRODUCT_IMAGE_AI_UPSCALE=true
# REPLICATE_API_TOKEN=r8_your_replicate_token

# ── ANALYTICS ────────────────────────────────────────────────
# (also set under ANALYTICS storefront block above)
