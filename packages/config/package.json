{
  "name": "@splaro/config",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./domains": {
      "types": "./dist/domains.d.ts",
      "require": "./dist/domains.js",
      "import": "./dist/domains.js",
      "default": "./dist/domains.js"
    },
    "./invoice-access": {
      "types": "./dist/invoice-access.d.ts",
      "require": "./dist/invoice-access.js",
      "import": "./dist/invoice-access.js",
      "default": "./dist/invoice-access.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-package.mjs tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit"
  }
}
