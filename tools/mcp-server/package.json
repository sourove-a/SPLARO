{
  "name": "@splaro/mcp-server",
  "version": "2.0.0",
  "private": true,
  "description": "SPLARO MCP server — stdio + private HTTP (Bearer link token) for catalog, orders, intelligence, and Nest-backed writes",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning start.mjs",
    "start:sse": "MCP_TRANSPORT=sse MCP_SSE_MESSAGE_PATH=/mcp/message node --disable-warning=ExperimentalWarning start.mjs",
    "type-check": "tsc --noEmit",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^5.16.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.0"
  }
}
