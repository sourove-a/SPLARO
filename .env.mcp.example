# Optional overrides for the read-only MCP server (tools/mcp-server).
#
# Copy to .env.mcp (gitignored) only when you want the MCP server to look at a
# different database than the rest of the repo. Without this file it falls back
# to .env.local, then .env.
#
# Production access goes through an SSH tunnel — never expose the database port:
#   ssh -N -L 55432:127.0.0.1:5432 user@your-host
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/splaro

# Store to scope every query to. Accepts an id or a slug.
# Falls back to NEXT_PUBLIC_STORE_ID, then the oldest active store.
SPLARO_MCP_STORE_ID=splaro
