# Optional overrides for the SPLARO MCP server (tools/mcp-server).
#
# Copy to .env.mcp (gitignored) only when MCP should use a different URL than
# the rest of the repo. Without this file it falls back to .env.local, then .env.
#
# Prefer local Docker for day-to-day MCP. For production reads, SSH tunnel —
# never expose the DB port and never put pooler credentials in a shared laptop .env:
#   ssh -N -L 55432:127.0.0.1:5432 user@your-host
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/splaro

# Store to scope every query to. Accepts an id or a slug.
# Falls back to NEXT_PUBLIC_STORE_ID, then the oldest active store.
SPLARO_MCP_STORE_ID=splaro
