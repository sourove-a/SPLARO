# Template for the Hostinger/VPS production env file.
# The real file lives ONLY on the server and is gitignored — never commit values.
# Empty keys below are secrets: generate fresh ones, do not reuse anything from git history.
#
#   openssl rand -base64 36   # JWT_SECRET / JWT_REFRESH_SECRET
#   openssl rand -base64 24   # ADMIN_SESSION_SECRET / REVALIDATE_SECRET / INTERNAL_HEALTH_SECRET
#   ENCRYPTION_KEY must be exactly 32 characters (AES-256).

# SPLARO production — splaro.co (hPanel env template — gitignored, never commit)
NODE_ENV=production
SPLARO_HOSTINGER=1

NEXT_PUBLIC_SITE_URL=https://splaro.co
NEXT_PUBLIC_ADMIN_URL=https://admin.splaro.co
NEXT_PUBLIC_API_URL=https://splaro.co/api/v1
NEXT_PUBLIC_CDN_URL=https://splaro.co
WEB_URL=https://splaro.co
ADMIN_URL=https://admin.splaro.co
API_URL=https://splaro.co/api/v1
INTERNAL_API_URL=http://127.0.0.1:4000/api/v1
CORS_ORIGINS=https://splaro.co,https://www.splaro.co,https://admin.splaro.co
NEXTAUTH_URL=https://splaro.co

NEXT_PUBLIC_STORE_ID=splaro
NEXT_PUBLIC_ADMIN_EMAIL=splaro.bd@gmail.com
ADMIN_EMAIL=splaro.bd@gmail.com

JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_SESSION_SECRET=
REVALIDATE_SECRET=
INTERNAL_HEALTH_SECRET=
ENCRYPTION_KEY=
# During rotation only: old key decrypts existing rows while new writes use ENCRYPTION_KEY.
ENCRYPTION_KEY_PREVIOUS=

# ── PostgreSQL (SPLARO API / Prisma — Neon Singapore) ───────────────────────
DATABASE_URL=
# Shadow DB not required for Neon migrate deploy — same URL is fine if Prisma asks
DATABASE_URL_SHADOW=

# ── Hostinger MySQL (phpMyAdmin only — NOT for DATABASE_URL) ───────────────
# Apply on server: bash infrastructure/hostinger/apply-hostinger-mysql-env.sh
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=u134578371_SPLARO
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_URL=
MYSQL_PHPMYADMIN_URL=

REDIS_ENABLED=false

API_PORT=4000
INTERNAL_WEB_PORT=3001
ADMIN_PORT=3002

PAYMENT_DEV_STUB=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ── Storefront Google Sign-in (customers) ───────────────────────────────────
# Must bake NEXT_PUBLIC_* into the web build — server-only GOOGLE_OAUTH_CLIENT_ID
# alone can flash-then-hide the button after /api/auth/config loads.
# Google Cloud → Authorized JavaScript origins: https://splaro.co , https://www.splaro.co
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# Never true on VPS — loopback GIS is local-dev only
NEXT_PUBLIC_GOOGLE_OAUTH_LOCAL_ENABLED=false
