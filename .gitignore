# Dependencies
node_modules/
.pnpm-store/

# Environment files — NEVER COMMIT
.env
.env.local
.env.production
.env.staging
.env.mcp
*.env
!.env.example
!**/.env.example
apps/*/.env.local
apps/*/.env.production
infrastructure/hostinger/.env.splaro.co.production
infrastructure/hostinger/hpanel-env.paste.txt

# Next.js
.next/
out/
dist/
